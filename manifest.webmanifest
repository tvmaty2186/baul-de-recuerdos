{
  "name": "Baúl de recuerdos",
  "short_name": "Baúl",
  "description": "Guardá chats de WhatsApp en tu Google Drive, ordenados y sin encriptar.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f1ea",
  "theme_color": "#5b4636",
  "icons": [
    { "src": "iconos/icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "iconos/icono-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "iconos/icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "archivos",
          "accept": ["application/zip", ".zip", "text/plain", ".txt", "audio/*", "image/*", "video/*", "application/*", "*/*"]
        }
      ]
    }
  }
}
